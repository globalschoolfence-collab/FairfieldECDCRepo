# Gmail SMTP — use an App Password (not your account password).
# Enable 2FA on your Google account, then create one at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# Where form submissions are emailed to
MAIL_FROM=your-gmail@gmail.com
MAIL_TO=fairfieldeducationcenters@gmail.com

# CORS — restrict to your GitHub Pages domain in production.
# Example: https://yourusername.github.io
ALLOWED_ORIGIN=*

# Local dev only (not used by Cloud Functions)
PORT=3222
